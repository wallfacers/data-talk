# IDE
.idea/
.vscode/
*.iml
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build output
server/target/
client/dist/
client/src-tauri/target/
client/src-tauri/gen/

# TS composite build artifacts — must not leak into source dirs (Vite
# picks up vite.config.js over vite.config.ts, causing bogus reloads)
client/vite.config.js
client/vite.config.d.ts
client/*.tsbuildinfo

# Node
client/node_modules/
package-lock.json

# Java
*.class
*.jar
*.war

# Data
server/data/*.db
server/data/*.db-shm
server/data/*.db-wal
server/data-talk-adapter/data/

# Logs
logs/
*.log
server/*/target/

# Worktrees
.worktrees/
