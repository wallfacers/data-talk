{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "parameters", "widgets", "layout", "version", "theme", "renderer"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "type": "string", "pattern": "^dash_[a-zA-Z0-9_]{4,}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "maxLength": 32768 },
    "defaultConnectionId": { "type": ["string", "null"] },
    "defaultDatabase": { "type": ["string", "null"] },
    "defaultSchema": { "type": ["string", "null"] },
    "theme": { "type": "string", "pattern": "^industry-" },
    "renderer": { "type": "string", "const": "bezel" },
    "refresh": { "$ref": "#/$defs/dashboardRefresh" },
    "version": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "integer", "minimum": 0 },
    "updatedAt": { "type": "integer", "minimum": 0 },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameterDef" } },
    "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } },
    "layout": { "$ref": "#/$defs/layoutV3" }
  },
  "$defs": {
    "dashboardRefresh": {
      "type": "object",
      "required": ["defaultIntervalMs", "pauseOnHidden"],
      "properties": {
        "defaultIntervalMs": { "type": "integer", "minimum": 1000 },
        "pauseOnHidden": { "type": "boolean" }
      }
    },
    "parameterDef": {
      "type": "object",
      "required": ["id", "scope", "name", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^(global|local):[a-zA-Z0-9_:]+$" },
        "scope": { "enum": ["global", "local"] },
        "ownerWidgetId": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "type": { "enum": ["date", "date_range", "string", "number", "string_list"] },
        "default": {}
      }
    },
    "layoutV3": {
      "type": "object",
      "required": ["engine", "template"],
      "properties": {
        "engine": { "const": "free" },
        "template": { "enum": [
          "single-focus",
          "two-column-left-heavy",
          "two-column-right-heavy",
          "three-column-kpi-center",
          "top-kpi-bottom-charts",
          "grid-equal"
        ]},
        "viewport": {
          "type": "object",
          "properties": {
            "minWidth": { "type": "integer", "minimum": 1 },
            "aspect": { "type": "string" }
          }
        }
      }
    },
    "chartSemantics": {
      "type": "object",
      "properties": {
        "chartType": { "enum": ["bar", "line", "area", "pie", "funnel", "scatter", "radar", "map"] },
        "colorScheme": { "enum": ["warm", "cool", "monochrome", "brand"] },
        "stacked": { "type": "boolean" },
        "showLegend": { "type": "boolean" },
        "showTooltip": { "type": "boolean" },
        "showAreaFill": { "type": "boolean" },
        "labelPosition": { "enum": ["inside", "outside", "none"] },
        "gridGap": { "enum": ["compact", "normal", "spacious"] },
        "rawEchartsOption": { "type": "object" }
      }
    },
    "widget": {
      "type": "object",
      "required": ["id", "type", "slot", "title", "options", "patternId"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+_w_[a-zA-Z0-9_]{4,32}$" },
        "type": { "enum": ["chart", "kpi", "table", "markdown", "filter", "section", "divider", "image"] },
        "slot": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 64 },
        "patternId": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
        "chartSemantics": { "$ref": "#/$defs/chartSemantics" },
        "refresh": { "$ref": "#/$defs/widgetRefresh" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameterDef" } },
        "query": { "$ref": "#/$defs/widgetQuery" },
        "options": { "type": "object" }
      }
    },
    "widgetRefresh": {
      "type": "object",
      "properties": {
        "intervalMs": { "type": "integer", "minimum": 1000 },
        "strategy": { "enum": ["DATA_ONLY", "FULL_RERENDER"] }
      }
    },
    "widgetQuery": {
      "type": "object",
      "required": ["sql", "paramRefs"],
      "properties": {
        "connectionId": { "type": ["string", "null"] },
        "database": { "type": ["string", "null"] },
        "schema": { "type": ["string", "null"] },
        "sql": { "type": "string" },
        "paramRefs": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
