{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datatalk.local/semantic/model-schema.json",
  "title": "Semantic Model YAML Schema",
  "description": "JSON Schema for a single domain Semantic Model yaml (dbt MetricFlow subset + DataTalk extensions)",
  "type": "object",
  "required": ["name", "version", "description", "last_modified", "authored_by"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "Domain name, used as filename prefix"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic version number, bumped on structural change"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable domain description"
    },
    "last_modified": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last modification"
    },
    "authored_by": {
      "type": "string",
      "enum": ["ai_inferred", "user_authored", "hybrid"],
      "description": "Provenance of the model content"
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/dimension" }
    },
    "measures": {
      "type": "array",
      "items": { "$ref": "#/$defs/measure" }
    },
    "metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/metric" }
    },
    "literal_mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      },
      "description": "dimension-name -> { natural-value -> db-value }"
    },
    "verified_query_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/verifiedQueryRef" }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["name", "type", "physical", "primary_key"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": ["primary", "secondary"]
        },
        "physical": {
          "type": "object",
          "required": ["table"],
          "properties": {
            "database": { "type": "string" },
            "schema": { "type": "string" },
            "table": { "type": "string", "minLength": 1 }
          }
        },
        "primary_key": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "foreign_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["column", "ref"],
            "properties": {
              "column": { "type": "string" },
              "ref": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" }
            }
          }
        },
        "description": { "type": "string" }
      }
    },
    "dimension": {
      "type": "object",
      "required": ["name", "entity", "expr", "type", "label_zh", "label_en"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "entity": { "type": "string" },
        "expr": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["categorical", "time", "numeric"]
        },
        "time_granularity": {
          "type": "string",
          "enum": ["day", "week", "month", "quarter", "year"]
        },
        "label_zh": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "measure": {
      "type": "object",
      "required": ["name", "entity", "agg", "expr", "label_zh", "label_en"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "entity": { "type": "string" },
        "agg": {
          "type": "string",
          "enum": ["sum", "count", "count_distinct", "avg", "max", "min"]
        },
        "expr": { "type": "string", "minLength": 1 },
        "filter": { "type": "string" },
        "label_zh": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "metric": {
      "type": "object",
      "required": ["name", "type", "label_zh", "label_en"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "ratio" }
          },
          "required": ["numerator", "denominator"]
        },
        {
          "properties": {
            "type": { "const": "derived" }
          },
          "required": ["base"]
        },
        {
          "properties": {
            "type": { "const": "cumulative" }
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": ["ratio", "derived", "cumulative"]
        },
        "numerator": { "type": "string" },
        "denominator": { "type": "string" },
        "base": { "type": "string" },
        "time_offset": { "type": "string" },
        "label_zh": { "type": "string", "minLength": 1 },
        "label_en": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "verifiedQueryRef": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
